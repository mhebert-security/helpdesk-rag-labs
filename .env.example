# Azure AI Foundry serverless endpoint (chat completion)
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-project>.services.ai.azure.com/models
AZURE_AI_FOUNDRY_KEY=<serverless-endpoint-key>
AZURE_AI_FOUNDRY_MODEL=DeepSeek-R1

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_INDEX=helpdesk-corpus
AZURE_SEARCH_KEY=<search-admin-key>

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-connection-string>

# Key Vault (used by later labs to fetch secrets via Managed Identity)
AZURE_KEYVAULT_URL=https://<your-vault>.vault.azure.net/
